{
  "name": "fluxgrid:-quantum-block-puzzle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "cross-env CAPACITOR_BUILD=true vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:build": "npm run build:android && npm run cap:sync",
    "android:build:release": "npm run build:android && npm run cap:sync && cd android && ./gradlew assembleRelease",
    "android:build:debug": "npm run build:android && npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run build:android && npm run cap:sync && cd android && ./gradlew bundleRelease",
    "android:build:async": "node scripts/android-build-async.js debug",
    "android:build:release:async": "node scripts/android-build-async.js release",
    "android:bundle:async": "node scripts/android-build-async.js bundle",
    "android:open": "npm run android:build && npm run cap:open",
    "android:dev": "npm run build:android && npm run cap:sync && npm run cap:open"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "babylonjs": "7.0.0",
    "clsx": "^2.1.1",
    "firebase": "^11.2.0",
    "framer-motion": "^12.34.2",
    "i18next": "^25.8.18",
    "lucide-react": "^0.574.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.8",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.11.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fast-check": "^4.6.0",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-static-copy": "^3.3.0",
    "vitest": "^4.1.0",
    "vitest-axe": "^0.1.0"
  }
}
