rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // === YARDIMCI FONKSİYONLAR ===
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    function isValidScore(score) {
      return score is int && score >= 0 && score <= 9999999;
    }
    
    // === USERS KOLEKSİYONU ===
    
    match /users/{uid} {
      allow read: if isAuthenticated() && isOwner(uid);
      
      allow create: if isAuthenticated() && isOwner(uid);
      
      allow update: if isAuthenticated() && isOwner(uid);
      // Note: isAnonymous, migrationCompleted, etc. are managed by Firebase Auth and Cloud Functions
      // Client can write these during account linking, but Cloud Function will override them
      
      // Subcollections
      match /achievements/{achievementId} {
        allow read, write: if isAuthenticated() && isOwner(uid);
      }
      
      match /dailyHistory/{date} {
        allow read, write: if isAuthenticated() && isOwner(uid);
      }
      
      match /pendingWrites/{writeId} {
        allow read, write: if isAuthenticated() && isOwner(uid);
      }
    }
    
    // === LEADERBOARD KOLEKSİYONU ===
    
    match /leaderboards/{mode}/scores/{uid} {
      allow read: if true; // Anyone can read - Requirement 5.1
      
      allow write: if isAuthenticated()
        && isOwner(uid)
        && isValidScore(request.resource.data.score)
        && !('flagged' in request.resource.data)
        && !('suspicious' in request.resource.data)
        && !('suspiciousReason' in request.resource.data)
        && !('reviewedAt' in request.resource.data);
      // Note: migratedFrom and migratedAt can only be set by Cloud Function (admin SDK)
      // Client writes won't include these fields, so no need to block them explicitly
    }
    
    match /leaderboards/{mode}/meta/{doc} {
      allow read: if true;
      allow write: if false; // Sadece Cloud Function
    }
    
    // === GÜNLÜK MEYDAN OKUMA ===
    
    match /dailyChallenges/{date} {
      allow read: if true;
      allow write: if false; // Sadece Cloud Function
    }
    
    // === UYGULAMA KONFİGÜRASYONU ===
    
    match /appConfig/{doc} {
      allow read: if true;
      allow write: if false; // Sadece Firebase Console / Admin SDK
    }
  }
}
