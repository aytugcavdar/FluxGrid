rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // === YARDIMCI FONKSİYONLAR ===
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    function isValidScore(score) {
      return score is int && score >= 0 && score <= 9999999;
    }
    
    function hasSchemaVersion(data) {
      return 'schemaVersion' in data && data.schemaVersion is int && data.schemaVersion >= 1;
    }
    
    function notUpdatingField(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == resource.data[field];
    }
    
    // === USERS KOLEKSİYONU ===
    
    match /users/{uid} {
      allow read: if isAuthenticated() && isOwner(uid);
      
      allow create: if isAuthenticated()
        && isOwner(uid)
        && hasSchemaVersion(request.resource.data);
      
      allow update: if isAuthenticated()
        && isOwner(uid)
        && notUpdatingField('uid')
        && notUpdatingField('createdAt');
      
      // Subcollections
      match /achievements/{achievementId} {
        allow read, write: if isAuthenticated() && isOwner(uid);
      }
      
      match /careerProgress/{levelIndex} {
        allow read, write: if isAuthenticated() && isOwner(uid);
      }
      
      match /dailyHistory/{date} {
        allow read, write: if isAuthenticated() && isOwner(uid);
      }
      
      match /pendingWrites/{writeId} {
        allow read, write: if isAuthenticated() && isOwner(uid);
      }
    }
    
    // === LEADERBOARD KOLEKSİYONU ===
    
    match /leaderboards/{mode}/scores/{uid} {
      allow read: if true;
      
      allow write: if isAuthenticated()
        && isOwner(uid)
        && isValidScore(request.resource.data.score);
    }
    
    match /leaderboards/{mode}/meta/{doc} {
      allow read: if true;
      allow write: if false; // Sadece Cloud Function
    }
    
    // === GÜNLÜK MEYDAN OKUMA ===
    
    match /dailyChallenges/{date} {
      allow read: if true;
      allow write: if false; // Sadece Cloud Function
    }
    
    // === UYGULAMA KONFİGÜRASYONU ===
    
    match /appConfig/{doc} {
      allow read: if true;
      allow write: if false; // Sadece Firebase Console / Admin SDK
    }
  }
}
