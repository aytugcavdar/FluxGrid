rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // === YARDIMCI FONKSİYONLAR ===
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    // === USERS KOLEKSİYONU ===
    
    match /users/{uid} {
      // Allow read/write for authenticated users (including anonymous) on their own document
      // Anonymous users have request.auth != null and a valid UID
      allow read, write: if isAuthenticated() && isOwner(uid);
      
      // Subcollections
      match /achievements/{achievementId} {
        allow read, write: if isAuthenticated() && isOwner(uid);
      }
      
      match /dailyHistory/{date} {
        allow read, write: if isAuthenticated() && isOwner(uid);
      }
      
      match /pendingWrites/{writeId} {
        allow read, write: if isAuthenticated() && isOwner(uid);
      }
    }
    
    // === LEADERBOARD KOLEKSİYONU ===
    
    match /leaderboards/{mode}/scores/{uid} {
      // Anyone can read
      allow read: if true;
      
      // Authenticated users (including anonymous) can write their own score
      allow write: if isAuthenticated() && isOwner(uid);
    }
    
    match /leaderboards/{mode}/meta/{doc} {
      allow read: if true;
      allow write: if false; // Sadece Cloud Function
    }
    
    // === GÜNLÜK MEYDAN OKUMA ===
    
    match /dailyChallenges/{date} {
      allow read: if true;
      allow write: if false; // Sadece Cloud Function
    }
    
    // === UYGULAMA KONFİGÜRASYONU ===
    
    match /appConfig/{doc} {
      allow read: if true;
      allow write: if false; // Sadece Firebase Console / Admin SDK
    }
  }
}
